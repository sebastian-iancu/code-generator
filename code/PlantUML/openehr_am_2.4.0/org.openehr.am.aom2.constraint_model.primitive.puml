@startuml

class C_BOOLEAN {
  + true_valid : Boolean [1]
  + false_valid : Boolean [1]
  + assumed_value : Boolean [0..1]
}

class C_STRING {
  + pattern : String [0..1]
  + list : List<String> [*]
  + list_open : Boolean [1]
  + assumed_value : String [0..1]
  + valid_value( a_value : String [1] ) : Boolean [1]
}

class C_INTEGER {
  + list : List<Integer> [*]
  + range : Interval<Integer> [0..1]
  + assumed_value : Integer [0..1]
}

class C_REAL {
  + list : List<Real> [*]
  + range : Interval<Real> [0..1]
  + assumed_value : Real [0..1]
}

abstract class C_ORDERED <T> {
  + constraint : List<Interval<T>> [*]
  + any_allowed() : Boolean [1]
  + c_value_conforms_to( other : C_ORDERED [1] ) : Boolean [1]
  + c_value_congruent_to( other : C_ORDERED [1] ) : Boolean [1]
}

class C_TERMINOLOGY_CODE {
  + constraint : String [1]
  + assumed_value : Terminology_code [0..1]
  + default_value : Terminology_code [1]
  + value_set_expanded() : List<String> [*]
  + value_set_substituted() : List<Uri> [*]
  + value_set_resolved() : List<Terminology_code> [*]
  + valid_value( a_value : Terminology_code [1] ) : Boolean [1]
  + prototype_value() : Terminology_code [1]
  + any_allowed() : Boolean [1]
  + c_value_conforms_to( other : C_TERMINOLOGY_CODE [1] ) : Boolean [1]
  + c_value_congruent_to( other : C_TERMINOLOGY_CODE [1] ) : Boolean [1]
}

abstract class C_TEMPORAL <T> {
  + pattern_constraint : String [0..1]
  + {abstract} valid_pattern_constraint( a_pattern : String [1] ) : Boolean [1]
  + {abstract} valid_pattern_constraint_replacement( a_pattern : String [1], an_other_pattern : String [1] ) : Boolean [1]
  + any_allowed() : Boolean [1]
  + c_value_conforms_to( other : C_ORDERED [1] ) : Boolean [1]
  + c_value_congruent_to( other : C_ORDERED [1] ) : Boolean [1]
}

class C_TIME {
  + minute_validity : VALIDITY_KIND [0..1]
  + second_validity : VALIDITY_KIND [0..1]
  + millisecond_validity : VALIDITY_KIND [0..1]
  + timezone_validity : VALIDITY_KIND [0..1]
  + range : Interval<Iso8601_time> [0..1]
  + assumed_value : Iso8601_time [0..1]
  + validity_is_range() : Boolean [1]
}

class C_DATE {
  + day_validity : VALIDITY_KIND [0..1]
  + month_validity : VALIDITY_KIND [0..1]
  + timezone_validity : VALIDITY_KIND [0..1]
  + range : Interval<Iso8601_date> [0..1]
  + assumed_value : Iso8601_date [0..1]
}

class C_DATE_TIME {
  + month_validity : VALIDITY_KIND [0..1]
  + day_validity : VALIDITY_KIND [0..1]
  + hour_validity : VALIDITY_KIND [0..1]
  + minute_validity : VALIDITY_KIND [0..1]
  + second_validity : VALIDITY_KIND [0..1]
  + millisecond_valdity : VALIDITY_KIND [0..1]
  + timezone_valdity : VALIDITY_KIND [0..1]
  + range : Interval<Iso8601_date_time> [0..1]
  + assumed_value : Iso8601_date_time [0..1]
  + validity_is_range() : Boolean [1]
}

class C_DURATION {
  + years_allowed : Boolean [0..1]
  + months_allowed : Boolean [0..1]
  + weeks_allowed : Boolean [0..1]
  + days_allowed : Boolean [0..1]
  + hours_allowed : Boolean [0..1]
  + minutes_allowed : Boolean [0..1]
  + seconds_allowed : Boolean [0..1]
  + fractional_seconds_allowed : Boolean [0..1]
  + range : Interval<Iso8601_duration> [0..1]
  + assumed_value : Iso8601_duration [0..1]
}

class C_TEMPORAL_DEFINITIONS {
  + valid_date_constraint_patterns : List<String> [1..*]
  + valid_date_constraint_replacements : Hash<String,List<String>> [1]
  + valid_time_constraint_patterns : List<String> [1..*]
  + valid_time_constraint_replacements : Hash<String,List<String>> [1]
  + valid_date_time_constraint_patterns : List<String> [1..*]
  + valid_date_time_constraint_replacements : Hash<String,List<String>> [1]
  + valid_duration_constraint_replacement( a_dur : String [1], other_dur : String [1] ) : Boolean [1]
  + valid_iso8601_date_constraint_pattern( s : String [1] ) : Boolean [1]
  + valid_iso8601_time_constraint_pattern( s : String [1] ) : Boolean [1]
  + valid_iso8601_date_time_constraint_pattern( s : String [1] ) : Boolean [1]
  + valid_iso8601_duration_constraint_pattern( s : String [1] ) : Boolean [1]
}

enum CONSTRAINT_STATUS {
  required = 0 
  extensible = 1 
  preferred = 2 
  example = 3 
}

C_PRIMITIVE <|-- C_BOOLEAN
C_PRIMITIVE <|-- C_STRING
C_PRIMITIVE <|-- C_INTEGER
C_PRIMITIVE <|-- C_REAL
C_PRIMITIVE_OBJECT <|-- C_ORDERED
C_PRIMITIVE_OBJECT <|-- C_TERMINOLOGY_CODE
C_ORDERED <|-- C_TEMPORAL
C_PRIMITIVE <|-- C_TIME
C_PRIMITIVE <|-- C_DATE
C_PRIMITIVE <|-- C_DATE_TIME
C_PRIMITIVE <|-- C_DURATION

@enduml