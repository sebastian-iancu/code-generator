@startuml

class C_ATTRIBUTE {
  + rm_attribute_name : String [1]
  + existence : Multiplicity_interval [0..1]
  + children : List<C_OBJECT> [*]
  + differential_path : String [0..1]
  + cardinality : Cardinality [0..1]
  + is_multiple : Boolean [1]
  + any_allowed() : Boolean [1]
  + is_mandatory() : Boolean [1]
  + rm_attribute_path() : String [1]
  + is_single() : Boolean [1]
  + c_congruent_to( other : ARCHETYPE_CONSTRAINT [1] ) : Boolean [1]
  + c_conforms_to( other : ARCHETYPE_CONSTRAINT [1], rmcc : FUNCTION<> [1] ) : Boolean [1]
  + is_prohibited() : Boolean [1]
}

abstract class ARCHETYPE_CONSTRAINT  #whitesmoke;line:gray;line.dotted;text:gray {
  + {abstract} is_subset_of( other : ARCHETYPE_CONSTRAINT [1] ) : Boolean [1]
  + {abstract} is_valid() : Boolean [1]
  + path() : String [1]
  + has_path( a_path : String [1] ) : Boolean [1]
}

ARCHETYPE_CONSTRAINT <|-- C_ATTRIBUTE


@enduml