@startuml

class C_TERMINOLOGY_CODE {
  + constraint : String [1]
  + assumed_value : Terminology_code [0..1]
  + default_value : Terminology_code [0..1]
  + constraint_status : CONSTRAINT_STATUS [0..1]
  + constraint_required() : Boolean [1]
  + effective_constraint_status() : Integer [1]
  + value_set_expanded() : List<String> [*]
  + value_set_substituted() : List<Uri> [*]
  + value_set_resolved() : List<Terminology_code> [*]
  + valid_value( a_value : Terminology_code [1] ) : Boolean [1]
  + prototype_value() : Terminology_code [1]
  + any_allowed() : Boolean [1]
  + c_value_conforms_to( other : C_TERMINOLOGY_CODE [1] ) : Boolean [1]
  + c_value_congruent_to( other : C_TERMINOLOGY_CODE [1] ) : Boolean [1]
}

class C_PRIMITIVE_OBJECT  #whitesmoke;line:gray;line.dotted;text:gray {
  + item : C_PRIMITIVE [1]
  + any_allowed() : Boolean [1]
}

abstract class C_DEFINED_OBJECT  #whitesmoke;line:gray;line.dotted;text:gray {
  + assumed_value : Any [0..1]
  + {abstract} valid_value( a_value : Any [1] ) : Boolean [1]
  + {abstract} prototype_value() : Any [1]
  + has_assumed_value() : Boolean [1]
  + {abstract} default_value() : Any [0..1]
  + {abstract} any_allowed() : Boolean [1]
}

abstract class C_OBJECT  #whitesmoke;line:gray;line.dotted;text:gray {
  + rm_type_name : String [1]
  + occurrences : Interval<Integer> [1]
  + node_id : String [1]
}

abstract class ARCHETYPE_CONSTRAINT  #whitesmoke;line:gray;line.dotted;text:gray {
  + {abstract} is_subset_of( other : ARCHETYPE_CONSTRAINT [1] ) : Boolean [1]
  + {abstract} is_valid() : Boolean [1]
  + path() : String [1]
  + has_path( a_path : String [1] ) : Boolean [1]
}

ARCHETYPE_CONSTRAINT <|-- C_OBJECT

C_OBJECT <|-- C_DEFINED_OBJECT

C_DEFINED_OBJECT <|-- C_PRIMITIVE_OBJECT

C_PRIMITIVE_OBJECT <|-- C_TERMINOLOGY_CODE


@enduml