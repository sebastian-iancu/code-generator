@startuml

abstract class BMM_MODEL_ELEMENT {
  + documentation : String [0..1]
}

abstract class BMM_FORMAL_ELEMENT {
  + type : BMM_TYPE [1]
  + is_nullable : Boolean [0..1]
  + {abstract} signature() : BMM_SIGNATURE [1]
  + is_boolean() : Boolean [1]
}

BMM_DEFINITIONS <|-- BMM_MODEL_ELEMENT
BMM_MODEL_ELEMENT <|-- BMM_FORMAL_ELEMENT

@enduml