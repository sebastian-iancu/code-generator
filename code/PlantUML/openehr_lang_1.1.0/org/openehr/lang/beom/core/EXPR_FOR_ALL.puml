@startuml

class EXPR_FOR_ALL {
  + condition : ASSERTION [1]
  + operand : EXPR_VALUE_REF [1]
}

abstract class EXPR_OPERATOR  #whitesmoke;line:gray;line.dotted;text:gray {
  + precedence_overridden : Boolean [0..1]
  + operator : OPERATOR_KIND [1]
}

abstract class EXPR_ITEM  #whitesmoke;line:gray;line.dotted;text:gray {
  + type : String [1]
}

EXPR_ITEM <|-- EXPR_OPERATOR

EXPR_OPERATOR <|-- EXPR_FOR_ALL


@enduml